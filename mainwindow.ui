  <property name="windowTitle">
   <string>EcoGest — Gestion Intelligente des Poubelles</string>
  </property>
  <property name="styleSheet">
   <string notr="true">
QMainWindow { background: #f0f4f8; }

/* SIDEBAR */
#sidebar {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #0d1b2a, stop:1 #1b2838);
}
#logoIcon { font-size: 42px; color: #00b894; }
#logoTitle { color: white; font-size: 22px; font-weight: bold; }
#logoSubtitle { color: #636e72; font-size: 11px; }
#sidebarSep, #sidebarSep2 { background: rgba(255,255,255,0.08); max-height:1px; min-height:1px; }
#sidebarVersion { color: #636e72; font-size: 10px; }

/* NAV BUTTONS */
#btnNavDashboard, #btnNavPoubelles, #btnNavStats, #btnNavHistorique {
    background: transparent; color: rgba(255,255,255,0.55); text-align: left;
    padding-left: 24px; border: none; border-left: 3px solid transparent;
    font-size: 13px; font-weight: 500;
}
#btnNavDashboard:hover, #btnNavPoubelles:hover, #btnNavStats:hover, #btnNavHistorique:hover {
    background: rgba(255,255,255,0.06); color: rgba(255,255,255,0.85);
}
#btnNavDashboard[checked=&quot;true&quot;], #btnNavPoubelles[checked=&quot;true&quot;], #btnNavStats[checked=&quot;true&quot;], #btnNavHistorique[checked=&quot;true&quot;] {
    background: rgba(0,184,148,0.12); color: #00b894; border-left: 3px solid #00b894; font-weight: bold;
}

/* HEADER */
#header { background: #ffffff; border-bottom: 1px solid #dfe6e9; }
#headerTitle { font-size: 20px; font-weight: bold; color: #2d3436; }

/* STAT CARDS */
#cardTotal, #cardFull, #cardBroken, #cardMaintenance { background: #ffffff; border-radius: 14px; }
#cardTotal { border-left: 4px solid #0984e3; }
#cardFull { border-left: 4px solid #d63031; }
#cardBroken { border-left: 4px solid #e17055; }
#cardMaintenance { border-left: 4px solid #fdcb6e; }
#iconTotal { color: #0984e3; font-size: 22px; }
#iconFull { color: #d63031; font-size: 22px; }
#iconBroken { color: #e17055; font-size: 22px; }
#iconMaint { color: #fdcb6e; font-size: 22px; }
#titleTotal, #titleFull, #titleBroken, #titleMaint { color: #636e72; font-size: 12px; font-weight: 600; }
#valueTotal, #valueFull, #valueBroken, #valueMaint { color: #2d3436; font-size: 32px; font-weight: bold; }
#subtitleTotal, #subtitleFull, #subtitleBroken, #subtitleMaint { color: #636e72; font-size: 11px; }

/* SECTION CARDS */
#gaugesCard, #recentCard, #poubelleTableCard, #statsCard, #distCard, #historyCard {
    background: #ffffff; border-radius: 14px; border: 1px solid rgba(0,0,0,0.04);
}
#gaugesTitle, #recentTitle { font-size: 15px; font-weight: bold; color: #2d3436; }

/* PROGRESS BARS */
QProgressBar {
    border: none; border-radius: 10px; background: #e8ecf1; text-align: center;
    font-size: 11px; font-weight: bold; color: #2d3436; min-height: 20px; max-height: 20px;
}
QProgressBar::chunk { border-radius: 10px; }
#progressAvg::chunk { background: #00b894; }
#progressFunc::chunk { background: #0984e3; }
#progressPleines::chunk { background: #d63031; }
#progressOrg::chunk { background: #27ae60; }
#progressPlast::chunk { background: #f39c12; }
#progressVerre::chunk { background: #2980b9; }
#progressPapier::chunk { background: #8e44ad; }
#progressMetal::chunk { background: #e74c3c; }
#progressMixte::chunk { background: #95a5a6; }

/* SEARCH */
#searchInput {
    background: #ffffff; border: 2px solid #dfe6e9; border-radius: 10px;
    padding: 0 16px; font-size: 13px; color: #2d3436;
}
#searchInput:focus { border-color: #00b894; }

/* COMBOBOX */
#comboFilterType, #comboFilterStatus, #histActionFilter {
    background: #ffffff; border: 2px solid #dfe6e9; border-radius: 10px;
    padding: 0 14px; font-size: 12px; color: #2d3436; min-width: 120px;
}
#comboFilterType:focus, #comboFilterStatus:focus, #histActionFilter:focus { border-color: #00b894; }
#comboFilterType::drop-down, #comboFilterStatus::drop-down, #histActionFilter::drop-down { border: none; padding-right: 10px; }
#comboFilterType QAbstractItemView, #comboFilterStatus QAbstractItemView, #histActionFilter QAbstractItemView {
    background: #ffffff; border: 1px solid #dfe6e9; border-radius: 6px; padding: 4px;
    selection-background-color: #00b894; selection-color: white;
}

/* ACTION BUTTONS */
#btnAdd { background: #00b894; color: white; border: none; border-radius: 10px; padding: 0 18px; font-weight: bold; font-size: 12px; }
#btnAdd:hover { background: #00a884; }
#btnEdit, #btnRefresh, #btnCSV { background: #ffffff; color: #2d3436; border: 2px solid #dfe6e9; border-radius: 10px; padding: 0 14px; font-weight: 600; font-size: 12px; }
#btnEdit:hover, #btnRefresh:hover, #btnCSV:hover { background: #f0f4f8; border-color: #00b894; color: #00b894; }
#btnDelete { background: #ffffff; color: #d63031; border: 2px solid #d63031; border-radius: 10px; padding: 0 14px; font-weight: 600; font-size: 12px; }
#btnDelete:hover { background: #ffeef0; }
#btnCollect { background: #ffffff; color: #00b894; border: 2px solid #00b894; border-radius: 10px; padding: 0 14px; font-weight: 600; font-size: 12px; }
#btnCollect:hover { background: #e6fff9; }
#btnFilterHist { background: #00b894; color: white; border: none; border-radius: 10px; padding: 0 18px; font-weight: bold; font-size: 12px; }
#btnFilterHist:hover { background: #00a884; }

/* TABLES */
QTableWidget {
    background: #ffffff; border: none; border-radius: 12px; gridline-color: transparent;
    selection-background-color: rgba(0,184,148,0.08); selection-color: #2d3436;
    font-size: 12px; alternate-background-color: #f8fafe;
}
QTableWidget::item { padding: 6px 8px; border-bottom: 1px solid #f0f4f8; }
QTableWidget::item:hover { background: rgba(0,184,148,0.04); }
QHeaderView::section {
    background: #ffffff; color: #636e72; padding: 12px 10px; border: none;
    border-bottom: 2px solid #dfe6e9; font-weight: bold; font-size: 12px;
}

/* DATE EDIT */
QDateEdit { background: #ffffff; border: 2px solid #dfe6e9; border-radius: 10px; padding: 6px 14px; color: #2d3436; font-size: 12px; }
QDateEdit:focus { border-color: #00b894; }
QDateEdit::drop-down { border: none; }

/* SCROLLBAR */
QScrollBar:vertical { background: transparent; width: 8px; }
QScrollBar::handle:vertical { background: rgba(0,0,0,0.15); border-radius: 4px; min-height: 30px; }
QScrollBar::handle:vertical:hover { background: rgba(0,0,0,0.25); }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal { background: transparent; height: 8px; }
QScrollBar::handle:horizontal { background: rgba(0,0,0,0.15); border-radius: 4px; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }

/* STATUS BAR */
QStatusBar { background: #ffffff; color: #636e72; border-top: 1px solid #dfe6e9; font-size: 12px; padding: 4px 12px; }

/* DOTS + LABELS */
#dotOrg { color: #27ae60; font-size: 16px; }
#dotPlast { color: #f39c12; font-size: 16px; }
#dotVerre { color: #2980b9; font-size: 16px; }
#dotPapier { color: #8e44ad; font-size: 16px; }
#dotMetal { color: #e74c3c; font-size: 16px; }
#dotMixte { color: #95a5a6; font-size: 16px; }
#lblOrg, #lblPlast, #lblVerre, #lblPapier, #lblMetal, #lblMixte { color: #2d3436; font-size: 13px; font-weight: 500; }
#statTotalLabel { color: #2d3436; font-size: 14px; font-weight: bold; }
#statAvgLabel { color: #636e72; font-size: 14px; }
#statusLabel { color: #636e72; font-size: 12px; }
#gaugeLabel1, #gaugeLabel2, #gaugeLabel3 { color: #636e72; font-size: 12px; font-weight: 500; }
#statsIndicTitle, #distTitle { font-size: 16px; font-weight: bold; color: #2d3436; }
#lblStatAvg, #lblStatFunc, #lblStatPleines { color: #636e72; font-size: 12px; font-weight: 500; }
#lblDu, #lblAu { color: #2d3436; font-weight: bold; font-size: 13px; }
   </string>
